{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run lint && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:harness": "node --experimental-strip-types --no-warnings tests/harness/run-all.mjs",
    "test:harness:api": "HARNESS_SKIP_BROWSER=1 node --experimental-strip-types --no-warnings tests/harness/run-all.mjs",
    "harness:preflight": "node --experimental-strip-types --no-warnings tests/harness/preflight.mjs",
    "harness:01": "node --experimental-strip-types --no-warnings tests/harness/feature-01-auth.mjs",
    "harness:02": "node --experimental-strip-types --no-warnings tests/harness/feature-02-login.mjs",
    "harness:03": "node --experimental-strip-types --no-warnings tests/harness/feature-03-posts.mjs",
    "harness:04": "node --experimental-strip-types --no-warnings tests/harness/feature-04-profile.mjs",
    "harness:05": "node --experimental-strip-types --no-warnings tests/harness/feature-05-requests.mjs",
    "harness:06": "node --experimental-strip-types --no-warnings tests/harness/feature-06-chat.mjs",
    "harness:07": "node --experimental-strip-types --no-warnings tests/harness/feature-07-match.mjs",
    "harness:08": "node --experimental-strip-types --no-warnings tests/harness/feature-08-completion.mjs",
    "harness:09": "node --experimental-strip-types --no-warnings tests/harness/feature-09-reviews.mjs",
    "harness:full-cycle": "node --experimental-strip-types --no-warnings tests/harness/full-cycle.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
